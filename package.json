{
  "name": "store-inventory-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:admin": "vite --config admin-console/vite.config.ts",
    "build": "tsc -b && vite build",
    "build:admin": "tsc -p admin-console/tsconfig.json --noEmit && vite build --config admin-console/vite.config.ts",
    "preview": "vite preview",
    "preview:admin": "vite preview --outDir dist-admin",
    "lint": "eslint .",
    "cap:sync": "npx cap sync",
    "ios:prepare": "npm run build && node --test tests/production-supabase-bundle.test.mjs && npx cap copy ios",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.1.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@supabase/supabase-js": "^2.45.4",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.468.0",
    "motion": "^12.42.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^15.13.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^1.2.0"
  },
  "overrides": {
    "@trickfilm400/rollup-plugin-off-main-thread": "4.0.0-pre2"
  }
}
